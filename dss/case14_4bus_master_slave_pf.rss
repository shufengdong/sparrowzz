        [12,13,0.22092,0.19988,0,0,0,0,0,0,1,-360,360],
        [13,14,0.17093,0.34802,0,0,0,0,0,0,1,-360,360]
    ];
};

// 请求三轮显式数据交换所需的全部配电潮流结果。
d_pf_para = select(
    col(base_frequency_hz),
    alias("bus_phase,branch_flow,source_flow,summary", result),
    d_import_para0
);

// 第 0 轮：使用配电网原始的 1 pu、0 度电源求解馈线，
// 形成单位为 MW/MVAr 的初始三相 PCC 等值功率。
[d_bus_phase0, d_branch_flow0, d_source_flow0, d_summary0] = ds_radial_pf(
    d_bus0, d_line0, d_linecode0, d_load0, d_transformer0, d_voltage_source0,
    d_motor0, d_transformer_winding0, d_transformer_impedance0,
    d_current_source0, d_generator0, d_ibr0, d_switch0, d_shunt0,
    d_capacitor0, d_reactor0, d_spectrum0, d_control_profile0, d_xy_curve0,
    d_storage0, d_pf_para
);
d_pcc_flow0 = filter(cols(p_from, q_from), col(element) == "line1", d_branch_flow0);
d_pq0 = select(
    alias(sum(col(p_from)) / 1000000.0, p_mw),
    alias(sum(col(q_from)) / 1000000.0, q_mvar),
    d_pcc_flow0
);

// 第 1 轮：把馈线等值功率叠加到母线 14 的原始负荷，然后运行 rspower。
// include 行位于数值代码块内部，因此全部轮次编排都能直接在本 .rss 文件中看到。
[t_pcc_power1, _, bus1, gen1, branch1, t_success1, t_iterations1] = {
#include sparrowzz/rspower/lib/idx_gen.txt
#include sparrowzz/rspower/lib/idx_bus.txt
#include sparrowzz/rspower/lib/idx_brch.txt
#include sparrowzz/rspower/lib/ext2int.txt
#include sparrowzz/rspower/lib/int2ext.txt
#include sparrowzz/rspower/lib/bustypes.txt
#include sparrowzz/rspower/lib/makeYbus.txt
#include sparrowzz/rspower/lib/dSbus_dV.txt
#include sparrowzz/rspower/lib/make_sdzip.txt
#include sparrowzz/rspower/lib/makeSbus.txt
#include sparrowzz/rspower/lib/newtonpf.txt
#include sparrowzz/rspower/lib/pfsoln.txt
#include sparrowzz/rspower/lib/total_load.txt
#include sparrowzz/rspower/lib/runpf.txt
    pcc_row = 13;
    pcc_power = d_pq0;
    t_bus_input = set(
        bus0,
        [pcc_row * 13 + 2, pcc_row * 13 + 3],
        [get(bus0, pcc_row, 2) + get(pcc_power, 0, 0), get(bus0, pcc_row, 3) + get(pcc_power, 0, 1)]
    );
    [v, solved_bus, solved_gen, solved_branch, success, iterations] = runpf_case(100, t_bus_input, gen0, branch0);
    return (pcc_power, v, solved_bus, solved_gen, solved_branch, [[success]], [[iterations]]);
};

t_pcc_voltage1 = filter(cols(col_7, col_8), col(col_0) == 14, bus1);
d_source_with_boundary1 = concat("horizontal", d_voltage_source0, t_pcc_voltage1);
d_voltage_source1 = with_columns(
    alias(col(v_magnitude) * col(col_7), v_magnitude),
    alias(col(v_angle) + radians(col(col_8)), v_angle),
    d_source_with_boundary1
);
[d_bus_phase1, d_branch_flow1, d_source_flow1, d_summary1] = ds_radial_pf(
    d_bus0, d_line0, d_linecode0, d_load0, d_transformer0, d_voltage_source1,
    d_motor0, d_transformer_winding0, d_transformer_impedance0,
    d_current_source0, d_generator0, d_ibr0, d_switch0, d_shunt0,
    d_capacitor0, d_reactor0, d_spectrum0, d_control_profile0, d_xy_curve0,
    d_storage0, d_pf_para
);
d_pcc_flow1 = filter(cols(p_from, q_from), col(element) == "line1", d_branch_flow1);
d_pq1 = select(
    alias(sum(col(p_from)) / 1000000.0, p_mw),
    alias(sum(col(q_from)) / 1000000.0, q_mvar),
    d_pcc_flow1
);

// 第 2 轮：显式采用 alpha=0.5 的松弛系数。每轮都从 bus0 重建主网母线输入，
// 避免重复累加馈线负荷。
[t_pcc_power2, _, bus2, gen2, branch2, t_success2, t_iterations2] = {
#include sparrowzz/rspower/lib/idx_gen.txt
#include sparrowzz/rspower/lib/idx_bus.txt
#include sparrowzz/rspower/lib/idx_brch.txt
#include sparrowzz/rspower/lib/ext2int.txt
#include sparrowzz/rspower/lib/int2ext.txt
#include sparrowzz/rspower/lib/bustypes.txt
#include sparrowzz/rspower/lib/makeYbus.txt
#include sparrowzz/rspower/lib/dSbus_dV.txt
#include sparrowzz/rspower/lib/make_sdzip.txt
#include sparrowzz/rspower/lib/makeSbus.txt
#include sparrowzz/rspower/lib/newtonpf.txt
#include sparrowzz/rspower/lib/pfsoln.txt
#include sparrowzz/rspower/lib/total_load.txt
#include sparrowzz/rspower/lib/runpf.txt
    pcc_row = 13;
    pcc_power = 0.5 * t_pcc_power1 + 0.5 * d_pq1;
    t_bus_input = set(
        bus0,
        [pcc_row * 13 + 2, pcc_row * 13 + 3],
        [get(bus0, pcc_row, 2) + get(pcc_power, 0, 0), get(bus0, pcc_row, 3) + get(pcc_power, 0, 1)]
    );
    [v, solved_bus, solved_gen, solved_branch, success, iterations] = runpf_case(100, t_bus_input, gen0, branch0);
    return (pcc_power, v, solved_bus, solved_gen, solved_branch, [[success]], [[iterations]]);
};

t_pcc_voltage2 = filter(cols(col_7, col_8), col(col_0) == 14, bus2);
