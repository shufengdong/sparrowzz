[d_bus0, d_line0, d_linecode0, d_load0, d_transformer0, d_voltage_source0, d_motor0, d_transformer_winding0, d_transformer_impedance0, d_current_source0, d_generator0, d_ibr0, d_switch0, d_shunt0, d_capacitor0, d_reactor0, d_spectrum0, d_control_profile0, d_xy_curve0, d_storage0, d_import_para0] = import_dss("sparrowzz/dss/models/4bus_daily_qsts/4bus_dy.dss");

