[d_bus_phase3, d_branch_flow3, d_source_flow3, d_summary3] = ds_radial_pf(
    d_bus0, d_line0, d_linecode0, d_load0, d_transformer0, d_voltage_source3,
    d_motor0, d_transformer_winding0, d_transformer_impedance0,
    d_current_source0, d_generator0, d_ibr0, d_switch0, d_shunt0,
    d_capacitor0, d_reactor0, d_spectrum0, d_control_profile0, d_xy_curve0,
    d_storage0, d_pf_para
);
d_pcc_flow3 = filter(cols(p_from, q_from), col(element) == "line1", d_branch_flow3);
d_pq3 = select(
    alias(sum(col(p_from)) / 1000000.0, p_mw),
    alias(sum(col(q_from)) / 1000000.0, q_mvar),
    d_pcc_flow3
);

// 生成紧凑的终端结果表，使 CLI 始终输出四组交换功率。
// 完整的 bus0..3、gen0..3、branch0..3、voltage_source0..3 以及
// d_bus_phase0..3、d_branch_flow0..3 DataFrame 仍作为计算图中的具名变量保存。
d_pq3_matrix = select(alias(col(p_mw), col_0), alias(col(q_mvar), col_1), d_pq3);
td_power_steps = concat("vertical", t_pcc_power1, t_pcc_power2, t_pcc_power3, d_pq3_matrix);
t_success_steps = concat("vertical", t_success1, t_success2, t_success3);
d_summary_steps = concat("vertical", d_summary0, d_summary1, d_summary2, d_summary3);
t_success_column = select(alias(col(col_0), transmission_success), t_success_steps);
d_converged_column = select(alias(cast(col(converged), f64), distribution_converged), d_summary_steps);
td_iteration_report = concat("horizontal", td_power_steps, t_success_column, d_converged_column);
