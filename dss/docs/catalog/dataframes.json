    "voltage_source": {
      "required": {"name": "str", "bus": "str", "terminal_map": "list<str>", "v_magnitude": "list<f64>", "v_angle": "list<f64>"},
      "optional": {"bus2": "str", "terminal_map2": "list<str>", "sc_va": "f64", "x_r": "f64", "z1_r": "f64", "z1_x": "f64", "z2_r": "f64", "z2_x": "f64", "z0_r": "f64", "z0_x": "f64", "scan_type": "str", "v_profile_base": "list<f64>", "pf_z_r": "f64", "pf_z_x": "f64", "spectrum": "str"}
