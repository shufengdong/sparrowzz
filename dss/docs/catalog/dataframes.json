      "optional": {"configuration": "str", "kva": "f64", "spectrum": "str"},
      "defaults": {"configuration": "DELTA", "kva": "1.2 * abs(kw)"}
    },
    "transformer_winding": {
      "note": "Use the exact schema emitted by import_dss; winding identity, connection, tap and ratings must match transformer and impedance rows."
    },
    "transformer_impedance": {
      "note": "Use the exact schema emitted by import_dss; rows describe pairwise winding short-circuit impedances."
    },
    "current_source": {
      "required": {"name": "str", "bus": "str", "terminal_map": "list<str>", "i_magnitude": "list<f64>", "i_angle": "list<f64>"},
      "optional": {"frequency_hz": "f64", "scan_type": "str", "spectrum": "str"},
      "defaults": {"frequency_hz": "network base_frequency_hz"}
    },
    "generator": {
      "required": {"name": "str", "bus": "str", "terminal_map": "list<str>", "configuration": "str", "p_nom": "list<f64>", "q_nom": "list<f64>"},
      "optional": {"execution_mode": "str", "v_ref": "list<f64>", "kvar_limit": "f64", "v_min_pu": "f64", "v_max_pu": "f64", "p_min": "list<f64>", "p_max": "list<f64>", "q_min": "list<f64>", "q_max": "list<f64>", "z_r": "f64", "z_x": "f64", "z1_r": "f64", "z1_x": "f64", "z0_r": "f64", "z0_x": "f64", "r_neutral": "f64", "x_neutral": "f64", "xdpp": "f64", "xdp": "f64", "s_rating": "f64", "v_nom": "f64", "x_r": "f64", "cost": "list<f64>", "s_max": "list<f64>", "i_max": "list<f64>", "spectrum": "str", "dispatcher": "str", "dispatch_bus_from": "str", "dispatch_bus_to": "str", "dispatch_terminal": "u32", "dispatch_kw_limit": "f64", "dispatch_kvar_limit": "f64", "dispatch_kw_band": "f64", "dispatch_weight": "f64"},
      "enums": {"execution_mode": ["CONSTANT_PQ", "CONSTANT_PV"]}
    },
    "ibr": {
      "required": {"name": "str", "bus": "str", "terminal_map": "list<str>", "topology": "str", "prime_mover": "str", "s_max": "list<f64>"},
      "optional": {"port_model": "str", "i_max": "list<f64>", "p_avail": "f64", "p_rated": "f64", "pct_p_rated": "f64", "q_setpoint": "f64", "watt_priority": "bool", "sc_model": "str", "v_nom": "f64", "sc_r_pct": "f64", "sc_x_pct": "f64", "p_min": "list<f64>", "p_max": "list<f64>", "q_min": "list<f64>", "q_max": "list<f64>", "e_mag_pu": "f64", "e_angle_deg": "f64", "gfm_angle_source": "str", "r_ohm": "f64", "x_ohm": "f64", "droop_p": "f64", "droop_q": "f64", "control_profile": "str", "invcontrol_member_order": "u32", "expcontrol_member_order": "u32", "voltage_aggregation": "str", "pmpp": "f64", "irradiance": "f64", "pct_pmpp": "f64", "temperature": "f64", "temperature_reference": "f64", "temperature_coefficient": "f64", "temperature_factor": "f64", "pv_pt_curve_x": "list<f64>", "pv_pt_curve_y": "list<f64>", "pv_eff_curve_x": "list<f64>", "pv_eff_curve_y": "list<f64>", "inverter_efficiency": "f64", "cut_in": "f64", "cut_out": "f64", "var_follow_inverter": "bool", "spectrum": "str"},
      "enums": {"topology": ["SINGLE_PHASE", "THREE_LEG", "FOUR_LEG"], "prime_mover": ["PV", "BATTERY", "GENERIC", "STATCOM", "DSTATCOM"]}
    },
    "switch": {
      "required": {"name": "str", "bus_from": "str", "bus_to": "str", "terminal_map_from": "list<str>", "terminal_map_to": "list<str>"},
      "optional": {"open": "bool", "i_max": "list<f64>", "i_normal": "list<f64>", "i_emergency": "list<f64>", "s_normal": "list<f64>", "s_emergency": "list<f64>"}
    },
    "shunt": {
      "required": {"name": "str", "bus": "str", "terminal_map": "list<str>", "g": "f64_or_matrix", "b": "f64_or_matrix"}
    },
    "capacitor": {
      "required": {"name": "str", "bus": "str", "terminal_map": "list<str>", "configuration": "str", "q_rated": "f64", "v_nom": "f64"},
      "optional": {"steps": "u32", "states": "list<bool>", "enabled": "bool"}
    },
    "reactor": {
      "note": "Multiple electrical forms are supported; prefer import_dss output or consult psa/src/dsa/parse/reactor.rs before hand-authoring."
    },
    "spectrum": {
      "required": {"name": "str", "h": "list<f64>", "mag_pct": "list<f64>", "angle_deg": "list<f64>"},
      "constraint": "h, mag_pct and angle_deg lists have equal length"
    },
    "control_profile": {
      "required": {"name": "str"},
      "optional": {"enabled": "bool", "mode": "str", "combi_mode": "str", "frequency_deviation_pu": "f64", "pf": "f64", "voltage_reference": "str", "volt_var_breakpoints": "list<f64>", "volt_var_q_limits": "list<f64>", "volt_var_q_unit": "str", "volt_var_q_ref": "str", "volt_var_p_min_for_q": "f64", "volt_var_p_min_for_q_max": "f64", "volt_watt_breakpoints": "list<f64>", "volt_watt_p_limits": "list<f64>", "volt_watt_charge_breakpoints": "list<f64>", "volt_watt_charge_p_limits": "list<f64>", "volt_watt_p_unit": "str", "volt_watt_p_ref": "str", "volt_watt_y_axis": "str", "watt_pf_breakpoints": "list<f64>", "watt_pf_pf": "list<f64>", "watt_var_breakpoints": "list<f64>", "watt_var_q_limits": "list<f64>", "drc_deadband_min": "f64", "drc_deadband_max": "f64", "drc_gain_low": "f64", "drc_gain_high": "f64", "drc_avg_window_sec": "f64", "hysteresis_offset": "f64", "voltage_curve_x_ref": "str", "avg_window_sec": "f64", "reactive_power_reference": "str", "delta_p_factor": "f64", "delta_q_factor": "f64", "voltage_change_tolerance": "f64", "var_change_tolerance": "f64", "active_p_change_tolerance": "f64", "rate_of_change_mode": "str", "lpf_tau": "f64", "rise_fall_limit": "f64", "control_model": "str", "mon_voltage_calc": "str", "monitored_bus": "str", "monitored_phases": "list<str>", "monitored_v_base": "f64", "v_setpoint": "f64", "avr_gain": "f64", "exp_vreg": "f64", "exp_slope": "f64", "exp_vreg_tau": "f64", "exp_q_bias": "f64", "exp_vreg_min": "f64", "exp_vreg_max": "f64", "exp_q_max_lead": "f64", "exp_q_max_lag": "f64", "exp_t_response": "f64", "prefer_q": "bool"},
      "enums": {"mode": ["VOLTVAR", "VOLTWATT", "DYNAMICREACCURR", "WATTPF", "WATTVAR", "AVR", "EXPCONTROL", "GFM"], "combi_mode": ["VV_VW", "VV_DRC", "GFM"]}
    },
    "xy_curve": {
      "required": {"name": "str", "x": "f64", "y": "f64"},
      "shape": "long table; one point per row"
    },
    "storage": {
