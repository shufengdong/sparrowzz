    "shape_assignment": {
      "required": {"device_kind": "str", "device": "str"},
      "optional": {"daily": "str", "yearly": "str", "duty": "str"}
    },
    "storage_controller": {
      "required": {"name": "str", "element": "str"},
      "optional": {"terminal": "u32", "mon_phase": "str", "mode_discharge": "str", "mode_charge": "str", "kw_target": "f64", "kw_target_low": "f64", "pct_kw_band": "f64", "pct_kw_band_low": "f64", "kw_band": "f64", "kw_band_low": "f64", "element_list": "list<str>", "weights": "list<f64>", "pct_rate_kw": "f64", "pct_rate_charge": "f64", "pct_reserve": "f64", "reset_level": "f64", "time_discharge_trigger": "f64", "time_charge_trigger": "f64", "inhibit_time": "f64", "t_up": "f64", "t_flat": "f64", "t_down": "f64", "kw_threshold": "f64", "disp_factor": "f64", "daily": "str", "yearly": "str", "duty": "str", "season_shape": "str", "season_targets": "list<f64>", "season_targets_low": "list<f64>", "enabled": "bool"},
      "enums": {"mode_discharge": ["PeakShave", "Follow", "Support", "Loadshape", "Time", "Schedule", "I-PeakShave"], "mode_charge": ["Loadshape", "Time", "PeakShaveLow", "I-PeakShaveLow"]}
