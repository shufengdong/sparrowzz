      "optional": {"p_rated": "list<f64>", "i_max": "list<f64>", "s_max": "list<f64>", "v_nom": "f64", "sc_r_pct": "f64", "sc_x_pct": "f64", "spectrum": "str", "watt_priority": "bool", "p_min": "list<f64>", "p_max": "list<f64>", "q_min": "list<f64>", "q_max": "list<f64>", "idling_loss": "f64", "cut_in": "f64", "cut_out": "f64", "var_follow_inverter": "bool", "voltage_model": "u32", "v_min_pu": "f64", "v_max_pu": "f64", "limit_current": "bool", "dispatch_mode": "str", "dispatch_state": "str", "charge_rate": "f64", "discharge_rate": "f64", "charge_trigger": "f64", "discharge_trigger": "f64", "time_charge_trigger": "f64"},
