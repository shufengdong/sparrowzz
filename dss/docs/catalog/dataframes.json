      "enums": {"kind": ["slg", "ll", "llg", "2pg", "3p", "3pg"]}
    }
  },
  "qsts_result_frames": {
    "common_appended_columns": {"time": "f64", "load_multiplier": "f64", "generation_multiplier": "f64"},
    "storage_state": ["name", "soc", "energy", "p_total", "q_total"],
    "storage_controller_state": ["name", "mode", "state", "monitored", "target", "deadband", "requested_p", "fleet_p", "inhibited", "locked"],
    "switch_control_state": ["name", "switched_obj", "switched_term", "switched_conductor", "state", "normal", "locked", "condition_active", "measurement", "pending_action", "due_time", "phases", "phase_states"],
    "fuse_state": ["name", "monitored_obj", "monitored_term", "switched_obj", "switched_term", "state", "blown", "current", "trip_time", "due_time", "phases", "phase_states"],
    "recloser_state": ["name", "monitored_obj", "monitored_term", "switched_obj", "switched_term", "switched_conductor", "state", "locked_out", "operation", "curve_mode", "phase_current", "ground_current", "trip_source", "trip_time", "pending_action", "due_time", "phases", "phase_states"],
    "relay_state": ["name", "relay_type", "monitored_obj", "monitored_term", "switched_obj", "switched_term", "switched_conductor", "state", "normal_state", "locked_out", "operation", "phase_current", "ground_current", "min_voltage", "max_voltage", "reverse_power", "negative_sequence_current", "negative_sequence_voltage", "generic_variable", "generic_value", "doc_current", "doc_current_angle", "doc_control_power", "distance_loop", "distance_impedance_re", "distance_impedance_im", "distance_reach_fraction", "td21_fault_detected", "td21_loop", "td21_directional_impedance_re", "td21_directional_impedance_im", "td21_distance", "td21_history_points", "td21_quiet_samples", "trip_source", "trip_time", "pending_action", "due_time", "phases", "phase_states"],
